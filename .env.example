# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Verified-data adapters. Leave URLs unset unless you have an authorised, documented feed.
# Never paste private bookmaker account passwords or session cookies here.
HOLLYWOODBETS_FIXTURES_URL=""
HOLLYWOODBETS_API_KEY=""

# Sports-data providers (documented API endpoints only).
# For historical score settlement, use a date-scoped SportMonks endpoint URL with {date},
# e.g. a documented /fixtures/date/{date} endpoint including participants;scores;state.
SPORTMONKS_FIXTURES_URL=""
SPORTMONKS_RESULTS_URL=""
SPORTMONKS_API_KEY=""
THERUNDOWN_FIXTURES_URL=""
THERUNDOWN_API_KEY=""
